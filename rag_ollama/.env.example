# ==============================================================================
# ROoP -- .env.example
# Скопируйте: cp .env.example .env  и отредактируйте.
# ==============================================================================

# Django
SECRET_KEY=django-insecure-change-me-in-production-abcdef123456
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=roop
POSTGRES_USER=roop
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# LLM Backend: "ollama" (прямое подключение) или "openwebui" (через Open WebUI)
# ------------------------------------------------------------------------------
LLM_BACKEND=ollama

# Ollama (при LLM_BACKEND=ollama)
# -- Docker (Ollama в контейнере рядом):
OLLAMA_URL=http://ollama:11434
# -- Локальная разработка (Ollama на этой же машине):
# OLLAMA_URL=http://localhost:11434
# -- Удалённый сервер (Ollama на другой машине в сети):
# OLLAMA_URL=http://192.168.1.100:11434

# Open WebUI (при LLM_BACKEND=openwebui)
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

EMBED_MODEL=nomic-embed-text
LLM_MODEL=mistral
# Таймаут (секунды) на каждый HTTP-запрос к Ollama (embed и chat).
# На CPU одна embed-партия из 10 чанков может занимать минуты — 300 с с запасом.
OLLAMA_REQUEST_TIMEOUT=300

# ------------------------------------------------------------------------------
# Ресурсные лимиты Ollama (только для локальной Ollama в Docker).
# Значения по умолчанию рассчитаны на машину с 16 ГБ RAM.
# ------------------------------------------------------------------------------
# Сколько моделей держать в памяти одновременно. При 1 чат-модель и
# embedding-модель не занимают RAM одновременно (экономия ~300 МБ и больше).
OLLAMA_MAX_LOADED_MODELS=1
# Сколько запросов Ollama обрабатывает параллельно. Каждый параллельный запрос
# умножает KV-кэш — на 16 ГБ это основной путь к OOM.
OLLAMA_NUM_PARALLEL=1
# Как долго модель остаётся в памяти после последнего запроса.
OLLAMA_KEEP_ALIVE=5m
# Размер контекстного окна. Больше окно — больше KV-кэш.
OLLAMA_CONTEXT_LENGTH=4096

# ------------------------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION=rag_documents

# ------------------------------------------------------------------------------
# RAG settings
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Сколько чанков извлекать из ChromaDB перед фильтрацией по порогу.
SEARCH_K=6
# Порог схожести: чанки ниже порога не попадают в контекст LLM.
# 0.0 = без фильтрации; 0.20 = консервативный порог (рекомендуется).
SEARCH_RELEVANCE_THRESHOLD=0.20
# Сколько чанков отправлять за один запрос embed к Ollama.
# Меньше = короче один запрос, меньше риск OOM на слабой машине.
EMBED_BATCH_SIZE=10

# ------------------------------------------------------------------------------
# Загрузка файлов
# ------------------------------------------------------------------------------
# Жёсткий лимит на размер одного документа, в БАЙТАХ.
# Файл больше лимита отклоняется до начала индексации: API отдаёт 413,
# UI показывает понятное сообщение.
# 26214400 = 25 МиБ — значение для машины с 16 ГБ RAM: извлечение текста,
# чанкинг и embeddings в пике занимают в несколько раз больше исходного файла.
MAX_UPLOAD_SIZE=26214400

# ------------------------------------------------------------------------------
# Gunicorn (Docker)
# ------------------------------------------------------------------------------
# ChromaDB работает встроенно (PersistentClient) внутри процесса Django,
# а indexing worker — поток внутри процесса. Оба требуют РОВНО ОДИН процесс:
# несколько worker-процессов держали бы каждый свою копию HNSW-индекса и
# писали бы в один каталог одновременно. Масштабируйтесь потоками, не процессами.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# ------------------------------------------------------------------------------
# Django superuser (created automatically on first container start)
# Generate a password: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ------------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-before-first-run
DJANGO_SUPERUSER_EMAIL=admin@localhost

# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
API_KEY=your-secret-api-key-change-me

# ------------------------------------------------------------------------------
# Публичные ссылки
# ------------------------------------------------------------------------------
# Срок жизни новой публичной ссылки в днях. Ссылка открывается без входа в
# систему, поэтому бессрочная остаётся доступной всем, кто когда-либо видел URL.
# 0 = ссылки не истекают. Отозвать ссылку можно в профиле в любой момент.
SHARE_LINK_TTL_DAYS=30

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
# TLS/SSL определяется АВТОМАТИЧЕСКИ по порту:
#   465 -> SSL | 587 -> STARTTLS | 25 -> без шифрования
#
# Пример для Yandex (порт 465, SSL):
#   EMAIL_HOST=smtp.yandex.ru
#   EMAIL_PORT=465
#
# Пример для Gmail (порт 587, STARTTLS):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#
# Для тестирования без SMTP (письма в логи Docker):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ROoP <noreply@example.com>

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
