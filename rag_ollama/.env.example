# Django
SECRET_KEY=django-insecure-change-me-in-production-abcdef123456
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=sqlite:///db.sqlite3

# LLM Backend: "ollama" (прямое подключение) или "openwebui" (через Open WebUI API)
LLM_BACKEND=ollama

# Ollama (при LLM_BACKEND=ollama)
# -- Docker (Ollama в контейнере рядом):
OLLAMA_URL=http://ollama:11434
# -- Локальная разработка (Ollama на этой же машине):
# OLLAMA_URL=http://localhost:11434
# -- Удалённый сервер (Ollama на другой машине в сети):
# OLLAMA_URL=http://192.168.1.100:11434

# Open WebUI (при LLM_BACKEND=openwebui)
# Open WebUI предоставляет OpenAI-совместимый API с авторизацией по ключу.
# OLLAMA_URL в этом режиме игнорируется -- всё идёт через Open WebUI.
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

EMBED_MODEL=nomic-embed-text
LLM_MODEL=mistral

# ChromaDB
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION=rag_documents

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEARCH_K=4

# API
API_KEY=your-secret-api-key-change-me

# Logging
LOG_LEVEL=INFO
