# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Django
db.sqlite3
*.sqlite3
staticfiles/
# Unanchored so it also covers rag_ollama/media/documents/ — user documents
# must never be committed.
**/media/documents/*
!**/media/documents/.gitkeep
logs/*.log
htmlcov/
coverage.xml

# ChromaDB
chroma_data/

# Корпоративные CA-сертификаты (см. make ollama-ca) — машинно-локальны
rag_ollama/certs/*
!rag_ollama/certs/.gitkeep

# Environment
.env
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Linter & Tests cache
.ruff_cache/
.pytest_cache/
.coverage
rag_ollama/.coverage

# Logs
rag_ollama/logs/
rag_ollama/logs/rag_system.log

# Machine-local tooling artefacts
.claude/
rag_ollama/.claude/
.codegraph/
